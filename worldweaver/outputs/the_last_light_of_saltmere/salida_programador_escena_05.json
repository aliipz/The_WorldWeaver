  "personajes": [
    {
      "id_nodo": "personaje_mara",
      "fase_aparicion": 0,
      "ficha_info": null,
      "dialogos": [
        {
          "fase": 0,
          "animacion": null,
          "puntos": [
            {
              "frases": [
                "This crystal was cut for darkness, and tonight it goes back to the light."
              ],
              "opciones": []
            },
            {
              "frases": [
                "Agnes said this lamp hasn't burned in forty years. My hands are steady, but my heart isn't."
              ],
              "opciones": [
                {
                  "etiqueta": "What will happen when it lights?",
                  "respuesta": "Either we sail home with a legend, or we don't sail home at all.",
                  "correcta": false
                },
                {
                  "etiqueta": "Are you afraid?",
                  "respuesta": "Afraid is part of the job. I just don't let it take the wheel.",
                  "correcta": false
                }
              ]
            }
          ],
          "pista": null
        },
        {
          "fase": 2,
          "animacion": "Jump",
          "puntos": [
            {
              "frases": [
                "Mara, keeper's ink, and a lighthouse burning over Saltmere. I never thought my name would sit so well."
              ],
              "opciones": []
            },
            {
              "frases": [
                "The book says the light is mine to watch until I pass it on. That's a promise I intend to keep."
              ],
              "opciones": [
                {
                  "etiqueta": "Will you stay here long?",
                  "respuesta": "As long as Saltmere needs me. But I suspect the sea will call me out again.",
                  "correcta": false
                },
                {
                  "etiqueta": "What about the crew?",
                  "respuesta": "They're already mending sails and planning a feast. A captain's place is wherever they are.",
                  "correcta": false
                }
              ]
            }
          ],
          "pista": null
        }
      ],
      "dialogos_con_item": [],
      "acciones": [
        {
          "tecla": "KeyQ",
          "etiqueta": "Salute the beam",
          "descripcion": "Mara lifts her chin and touches her brow in a grave, joyful salute to the returning light.",
          "animacion": "Victory",
          "narrativa": false,
          "fase_aparicion": 0,
          "sonido": "alegria",
          "dispara": []
        }
      ],
      "dispara": {
