    },
    {
      "id_nodo": "personaje_agnes",
      "fase_aparicion": 2,
      "ficha_info": null,
      "dialogos": [
        {
          "fase": 2,
          "animacion": "Victory",
          "puntos": [
            {
              "frases": [
                "Saltmere will never be dark again. And your name, Mara, will guard it longer than my old bones."
              ],
              "opciones": []
            },
            {
              "frases": [
                "I have written many names in this book, but yours came with a storm behind it."
              ],
              "opciones": [
                {
                  "etiqueta": "What happens to the lighthouse now?",
                  "respuesta": "It burns, child. And you'll come back to see it, won't you?",
                  "correcta": false
                },
                {
                  "etiqueta": "Why did you choose me?",
                  "respuesta": "Because you didn't ask for this. You simply saw the dark and answered it.",
                  "correcta": false
                }
              ]
            }
          ],
          "pista": null
        }
      ],
      "dialogos_con_item": [],
      "acciones": [
