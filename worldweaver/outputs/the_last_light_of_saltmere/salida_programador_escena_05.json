      }
    },
    {
      "id_nodo": "personaje_finn",
      "fase_aparicion": 1,
      "ficha_info": null,
      "dialogos": [
        {
          "fase": 1,
          "animacion": "Victory",
          "puntos": [
            {
              "frases": [
                "There she goes! The old girl's painted the whole ocean gold, and I've got the best seat in the house."
              ],
              "opciones": []
            },
            {
              "frases": [
                "That beam will reach every boat from here to the eastern rocks. Saltmere's calling her folk home."
              ],
              "opciones": [
                {
                  "etiqueta": "Will we sail out to meet them?",
                  "respuesta": "Not yet. First we let the light settle, and then we feast.",
                  "correcta": false
                },
                {
                  "etiqueta": "Can the beam really reach that far?",
                  "respuesta": "Aye. This lamp has been sleeping too long. Now it's roaring like a bonfire.",
                  "correcta": false
                }
              ]
            }
          ],
          "pista": null
        }
      ],
      "dialogos_con_item": [],
      "acciones": [
        {
          "tecla": "KeyT",
          "etiqueta": "Cheer",
          "descripcion": "Old Finn wheels his cap overhead and shouts a hoarse sailor's cheer toward the tower.",
          "animacion": "Victory",
          "narrativa": false,
          "fase_aparicion": 1,
          "sonido": "alegria",
          "dispara": []
        }
      ],
      "dispara": {
