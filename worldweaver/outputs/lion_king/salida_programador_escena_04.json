            {
              "frases": [
                "The thunder roars, but my heart roars louder—Scar, your reign ends now!"
              ],
              "opciones": []
            },
            {
              "frases": [
                "Your shadows cannot hide the truth of the sky."
              ],
              "opciones": [
                {
                  "etiqueta": "What truth?",
                  "respuesta": "The storm will wash away the lies you built.",
                  "correcta": false
                },
                {
                  "etiqueta": "And if I resist?",
                  "respuesta": "Even the fiercest wind bows to the sunrise.",
