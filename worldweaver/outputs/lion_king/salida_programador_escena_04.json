          "puntos": [
            {
              "frases": [
                "The rain falls, and with it, a new dawn—our savanna breathes again!"
              ],
              "opciones": []
            },
            {
              "frases": [
                "From ashes we rise, stronger than ever."
              ],
              "opciones": [
                {
                  "etiqueta": "Will the kingdom endure?",
                  "respuesta": "As long as we protect it, the earth will remember us.",
                  "correcta": false
                },
                {
                  "etiqueta": "What of the wounds?",
                  "respuesta": "They are scars of courage, not defeat.",
                  "correcta": false
                }
              ]
