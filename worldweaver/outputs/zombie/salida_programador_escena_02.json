      "dialogos": [
        {
          "fase": 0,
          "animacion": null,
          "puntos": [
            {
              "frases": [
                "For a heartbeat, the darkness inside me softened, and I saw you, Emily, as if you were a moonlit garden."
              ],
              "opciones": []
            },
            {
              "frases": [
                "My hunger recoils, replaced by a strange, fierce protectiveness."
              ],
              "opciones": [
                {
                  "etiqueta": "What changed?",
                  "respuesta": "Your presence rewrote the echo of my dying heart.",
                  "correcta": false
                },
                {
                  "etiqueta": "Can I trust you?",
                  "respuesta": "I will stand between you and the abyss, no matter the cost.",
                  "correcta": false
                }
              ]
            }
          ],
          "pista": null
        },
        {
          "fase": 1,
          "animacion": "Victory",
          "puntos": [
            {
              "frases": [
                "I raise my trembling arm, a barrier of rot and resolve, to keep the horde at bay."
              ],
              "opciones": []
            },
            {
              "frases": [
                "The world shivers, but I will not let it claim you."
              ],
              "opciones": [
                {
                  "etiqueta": "Will you hold your ground?",
                  "respuesta": "Until the last breath leaves my corpse.",
                  "correcta": false
                },
                {
                  "etiqueta": "What if they overwhelm us?",
                  "respuesta": "I will become the wall that shatters their advance.",
                  "correcta": false
                }
              ]
            }
          ],
          "pista": null
        },
        {
          "fase": 2,
          "animacion": "Victory",
          "puntos": [
            {
              "frases": [
                "Your whispered thanks bind my purpose; I will guard you with the remnants of my soul."
              ],
              "opciones": []
            },
            {
              "frases": [
                "Love, a strange curse, now fuels my every step."
              ],
              "opciones": [
                {
                  "etiqueta": "Will you stay?",
                  "respuesta": "As long as my heart beats, I will stay.",
                  "correcta": false
                },
                {
                  "etiqueta": "What will happen if you fall?",
                  "respuesta": "My sacrifice will be the shield that saves you.",
                  "correcta": false
                }
              ]
            }
          ],
          "pista": null
        }
