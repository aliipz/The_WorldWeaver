  "personajes": [
    {
      "id_nodo": "personaje_patito_feo",
      "fase_aparicion": 0,
      "ficha_info": null,
      "dialogos": [
        {
          "fase": 0,
          "animacion": "susto",
          "puntos": [
            {
              "frases": [
                "El cielo gris me aplasta, pero sigo adelante, aunque el miedo me oprime."
              ],
              "opciones": []
            },
            {
              "frases": [
                "Este pantano huele a abandono, ¿qué esperanza queda para un patito como yo?"
              ],
              "opciones": [
                {
                  "etiqueta": "¿Vas a seguir adelante?",
                  "respuesta": "Cada paso es un grito contra la soledad."
                },
                {
                  "etiqueta": "¿Hay salida?",
                  "respuesta": "Tal vez el bosque al otro lado, pero la niebla lo oculta."
                }
              ]
            }
          ]
        },
        {
          "fase": 1,
          "animacion": "null",
          "puntos": [
            {
              "frases": [
                "El perro me olfatea, su mirada es como un espejo roto que no refleja nada."
              ],
              "opciones": []
            },
            {
              "frases": [
                "Se aleja sin mirarme, dejando una sombra que aún me persigue."
              ],
              "opciones": [
                {
                  "etiqueta": "¿Te asusta?",
                  "respuesta": "Más que su presencia, es la certeza de que nunca seré visto."
                },
                {
                  "etiqueta": "¿Qué harás ahora?",
                  "respuesta": "Buscaré refugio donde la humedad no me ahogue."
                }
              ]
            }
          ]
        },
        {
          "fase": 2,
          "animacion": "susto",
          "puntos": [
            {
              "frases": [
                "Dentro del tronco podrido, el crujido me recuerda que el mundo está a punto de colapsar."
              ],
              "opciones": []
            },
            {
              "frases": [
                "Escucho el latido del agua, como un corazón que late bajo la tierra."
              ],
              "opciones": [
                {
                  "etiqueta": "¿Te sientes seguro?",
                  "respuesta": "Solo el silencio me protege, aunque sea frágil."
                },
                {
                  "etiqueta": "¿Qué esperas encontrar?",
                  "respuesta": "Tal vez la luz que rompa esta niebla."
                }
              ]
            }
          ]
        }
      ],
      "dialogos_con_item": [],
      "acciones": [
        {
          "tecla": "KeyQ",
          "etiqueta": "Nadar",
          "descripcion": "Te sumerges ligeramente en el agua estancada, moviendo las hojas de los juncos.",
          "animacion": "alegria",
          "narrativa": true,
          "fase_aparicion": 0,
          "sonido": "agua",
