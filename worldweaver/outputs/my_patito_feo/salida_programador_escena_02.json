    {
      "id_nodo": "personaje_perro_caza",
      "fase_aparicion": 1,
      "ficha_info": null,
      "dialogos": [
        {
          "fase": 1,
          "animacion": "null",
          "puntos": [
            {
              "frases": [
                "El olor del patito me llega, pero mi instinto me dice que no es mi presa hoy."
              ],
              "opciones": []
            },
            {
              "frases": [
                "Me alejo, dejando atrás el eco de sus aleteos temblorosos."
              ],
              "opciones": [
                {
                  "etiqueta": "¿Por qué lo ignoras?",
                  "respuesta": "Porque el bosque guarda sus propios secretos y yo no soy su guardián."
                },
                {
                  "etiqueta": "¿Volverás?",
                  "respuesta": "Solo el viento me guiará, y él no tiene tiempo para los patitos."
                }
              ]
            }
          ]
        }
      ],
