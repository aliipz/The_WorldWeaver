            {
              "frases": [
                "Salgo del cascarón y el mundo parece un inmenso cielo gris."
              ],
              "opciones": []
            },
            {
              "frases": [
                "¿Alguien me mostrará el camino?"
              ],
              "opciones": [
                {
                  "etiqueta": "Te protegeré.",
                  "respuesta": "Un pequeño gesto de esperanza ilumina mi pecho."
                },
                {
                  "etiqueta": "Eres diferente, pero está bien.",
                  "respuesta": "Siento que tal vez, por fin, alguien me entiende."
                }
              ]
            }
          ]
        }
      ],
