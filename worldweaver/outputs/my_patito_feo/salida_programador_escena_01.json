  "personajes": [
    {
      "id_nodo": "personaje_mama_pata",
      "fase_aparicion": 0,
      "ficha_info": null,
      "dialogos": [
        {
          "fase": 0,
          "animacion": null,
          "puntos": [
            {
              "frases": [
                "El sol dorado ya acaricia la paja, y mis huevos se meven bajo su calor."
              ],
              "opciones": []
            },
            {
              "frases": [
                "Espero que el día les traiga fuerza y seguridad a mis polluelos."
              ],
              "opciones": [
                {
                  "etiqueta": "¿Los protegerás de todo?",
                  "respuesta": "Haré lo que sea para que estén a salvo, aunque el mundo sea grande."
                },
                {
                  "etiqueta": "¿Qué pasa si algo sale mal?",
                  "respuesta": "Mi corazón latirá más fuerte, pero nunca dejaré de cuidarlos."
                }
              ]
            }
          ]
        },
        {
          "fase": 2,
          "animacion": "susto",
          "puntos": [
            {
              "frases": [
                "Miro a mis pequeños y escucho sus risas... ¿qué les pasa?"
              ],
              "opciones": [
                {
                  "etiqueta": "¿Por qué se burlan?",
                  "respuesta": "Tal vez no entienden la diferencia, pero el cariño sigue aquí."
                },
                {
                  "etiqueta": "¿Puedes ayudar al patito feo?",
                  "respuesta": "Haré lo que pueda, aunque el miedo me apriete el pecho."
                }
              ]
            }
          ]
        }
      ],
      "dialogos_con_item": [],
      "acciones": [
        {
          "tecla": "KeyQ",
          "etiqueta": "Acunar",
          "descripcion": "Mamá Pata extiende su ala y acuna al patito feo, murmurando palabras de consuelo.",
