          "fase": 2,
          "animacion": "alegria",
          "puntos": [
            {
              "frases": [
                "¡Jajá! Ese patito gris no sabe ni volar, es una fiesta de tropiezos."
              ],
              "opciones": [
                {
                  "etiqueta": "Basta, es cruel.",
                  "respuesta": "Quizás nuestras palabras hieren más que cualquier pico."
                },
                {
                  "etiqueta": "¿Te gustaría ayudarlo?",
                  "respuesta": "Podríamos enseñarle a caminar antes de reírnos."
                }
              ]
