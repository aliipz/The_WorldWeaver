      "dialogos": [
        {
          "fase": 2,
          "animacion": "alegria",
          "puntos": [
            {
              "frases": [
                "¡Mira al patito gris! Parece una nube torpe en el patio."
              ],
              "opciones": [
                {
                  "etiqueta": "Deja de burlarte.",
                  "respuesta": "Tal vez tu risa no sea tan divertida para él."
                },
                {
                  "etiqueta": "¿Por qué te burlas?",
                  "respuesta": "Solo juego, pero quizás deberíamos ser más amables."
                }
              ]
            }
          ]
        }
      ],
      "dialogos_con_item": [],
