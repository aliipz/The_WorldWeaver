    },
    {
      "id_nodo": "personaje_cisne_02",
      "fase_aparicion": 2,
      "ficha_info": null,
      "dialogos": [
        {
          "fase": 2,
          "animacion": "alegria",
          "puntos": [
            {
              "frases": [
                "¡Qué alegría verte! El sol pinta de dorado nuestras plumas y tu corazón."
              ],
              "opciones": []
            },
            {
              "frases": [
                "Este es el comienzo de una nueva canción, donde cada nota es un latido de esperanza."
              ],
              "opciones": [
                {
                  "etiqueta": "¿Cuál será la primera nota?",
                  "respuesta": "El susurro del viento entre los juncos."
                },
                {
                  "etiqueta": "¿Quieres unirte a nuestro vuelo?",
                  "respuesta": "Sí, sigue mi ritmo y juntos brillaremos."
                }
              ]
            }
          ]
        }
      ],
