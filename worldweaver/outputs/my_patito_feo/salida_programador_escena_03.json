              ],
              "opciones": []
            },
            {
              "frases": [
                "¿Qué haces aquí, plumón deslucido?"
              ],
              "opciones": [
                {
                  "etiqueta": "Solo busco refugio.",
                  "respuesta": "Refugio es para los fuertes, no para los débiles."
                },
                {
                  "etiqueta": "Quiero compartir la leche.",
                  "respuesta": "La leche es para mí; aleja tus patitas."
