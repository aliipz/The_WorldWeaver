      "dialogos": [
        {
          "fase": 0,
          "animacion": "susto",
          "puntos": [
            {
              "frases": [
                "El calor de la chimenea me abraza, pero el silencio me pesa."
              ],
              "opciones": []
            },
            {
              "frases": [
                "¿Hay alguien allí que pueda compartir un poco de calor?"
              ],
              "opciones": [
                {
                  "etiqueta": "¿Estás perdido?",
                  "respuesta": "Sí, el viento del exterior me arrastró hasta aquí sin rumbo."
                },
                {
                  "etiqueta": "¿Qué te trae aquí?",
                  "respuesta": "Solo buscaba un refugio del invierno que me golpea sin piedad."
                }
              ]
            }
          ]
        },
        {
          "fase": 1,
          "animacion": "null",
          "puntos": [
            {
              "frases": [
                "El gato me mira con ojos de hielo; su gruñido corta el aire."
              ],
              "opciones": []
            },
            {
              "frases": [
                "No sé cómo calmar su ira."
              ],
              "opciones": [
                {
                  "etiqueta": "Inténtalo con una canción.",
                  "respuesta": "Mi canto es solo un susurro que se pierde en la madera."
                },
                {
                  "etiqueta": "Ofrece la leche.",
                  "respuesta": "El gato la olfatea y se retira, pero su mirada sigue siendo un muro."
                }
              ]
            }
          ]
        }
      ],
      "dialogos_con_item": [],
      "acciones": [
