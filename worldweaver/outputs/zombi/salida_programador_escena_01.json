            {
              "frases": [
                "Hold onto me, the ground is slick with mud and blood."
              ],
              "opciones": []
            },
            {
              "frases": [
                "If we keep low, they can't see our silhouettes."
              ],
              "opciones": [
                {
                  "etiqueta": "I'll stay low.",
                  "respuesta": "Good, keep your breathing shallow.",
                  "correcta": false
                },
                {
                  "etiqueta": "I'll try to draw them away.",
                  "respuesta": "Then move fast, make noise, and pull them past the trees.",
