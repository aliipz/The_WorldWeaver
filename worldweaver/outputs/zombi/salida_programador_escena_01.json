              "frases": [
                "Run! The horde's closing in, don't look back!"
              ],
              "opciones": []
            },
            {
              "frases": [
                "We have to find a gap in those trunks before they surround us."
              ],
              "opciones": [
                {
                  "etiqueta": "Where's the gap?",
                  "respuesta": "Near the old oak, it's barely wide enough.",
                  "correcta": false
                },
                {
