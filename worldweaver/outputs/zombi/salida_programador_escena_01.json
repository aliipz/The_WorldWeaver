          "puntos": [
            {
              "frases": [
                "The color... it's strange, like fire in the night."
              ],
              "opciones": []
            },
            {
              "frases": [
                "I feel a strange pull, a memory of something lost."
              ],
              "opciones": [
                {
                  "etiqueta": "What do you want?",
