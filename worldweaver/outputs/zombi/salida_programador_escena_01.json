      "dialogos": [
        {
          "fase": 0,
          "animacion": null,
          "puntos": [
            {
              "frases": [
                "My hair is tangled, the mist clings to it like a ghost."
              ],
              "opciones": []
            },
            {
              "frases": [
                "I think I see a narrow opening between those roots."
              ],
              "opciones": [
                {
                  "etiqueta": "I'll follow you.",
                  "respuesta": "Stay close, don't let the zombies catch your heels.",
                  "correcta": false
                },
                {
                  "etiqueta": "We should hide here.",
                  "respuesta": "The branches are too thin, they'll break under their weight.",
                  "correcta": false
                }
              ]
            }
          ],
          "pista": null
        },
        {
          "fase": 1,
          "animacion": null,
          "puntos": [
            {
              "frases": [
                "The mist is thick, I can barely see the path ahead."
              ],
              "opciones": []
            },
            {
              "frases": [
                "Listen for the rustle of leaves; that's where they move."
              ],
              "opciones": [
                {
                  "etiqueta": "I'll keep my ear open.",
                  "respuesta": "Good, any sound means a chance to slip by.",
                  "correcta": false
                },
                {
                  "etiqueta": "We need to move faster.",
                  "respuesta": "Then push harder, but don't trip on the roots.",
                  "correcta": false
                }
              ]
            }
          ],
          "pista": null
        },
        {
          "fase": 2,
          "animacion": null,
          "puntos": [
            {
              "frases": [
                "Why are you staring? My hair... it's a beacon for you."
              ],
              "opciones": []
            },
            {
              "frases": [
                "I can't move, his eyes are locked on the strands."
              ],
              "opciones": [
                {
                  "etiqueta": "Stay still.",
                  "respuesta": "Your stillness might confuse it, but it's risky.",
                  "correcta": false
                },
                {
                  "etiqueta": "Run!",
                  "respuesta": "Run now, before it decides to reach.",
                  "correcta": false
                }
              ]
            }
          ],
          "pista": null
        }
